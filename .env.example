# Local demo starts with SQLite; your existing MySQL data is not modified.
DB_ENGINE=sqlite
SQLITE_PATH=database/reviewguard.db
SEED_DEMO=true
# Hosted: SEED_DEMO=false and SEED_CATALOGUE=true.
# Set ADMIN_EMAIL and ADMIN_PASSWORD only in private Railway variables.
# ADMIN_PASSWORD must be unique and at least 16 characters.
# Remove bootstrap variables after provisioning; existing accounts are not reset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional existing MySQL database (create the database first).
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=reviewguard
